#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission.py:0
#, python-format
msgid ""
"\n"
"Context: Cancel admission\n"
"Database ID: %s\n"
"Problem: Payment term '%s' is already linked to an invoice\n"
"Solution: Delete or disconnect the invoice on the payment term before "
"cancelling this admission\n"
msgstr ""
"\n"
"Konteks: Batalkan penerimaan\n"
"ID Database: %s\n"
"Masalah: Termin pembayaran '%s' sudah terhubung dengan faktur\n"
"Solusi: Hapus atau lepaskan faktur pada termin pembayaran sebelum membatalkan penerimaan ini\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/wizards/school_admission_copy_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Copy payment terms between admissions\n"
"Database ID: %s\n"
"Problem: No target admission selected\n"
"Solution: Select at least one draft admission from the list view before "
"running this wizard\n"
msgstr ""
"\n"
"Konteks: Salin termin pembayaran antar penerimaan\n"
"ID Database: %s\n"
"Masalah: Tidak ada penerimaan tujuan yang dipilih\n"
"Solusi: Pilih minimal satu penerimaan berstatus draf dari tampilan daftar sebelum menjalankan wizard ini\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/wizards/school_admission_copy_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Copy payment terms from admission '%s'\n"
"Database ID: %s\n"
"Problem: The following target admission(s) cannot receive payment terms:\n"
"%s\n"
"Solution: Deselect the listed admission(s), or make sure they are draft, "
"allowed by\n"
"the copy payment term policy, and share the same academic term/school/grade "
"as the\n"
"source\n"
msgstr ""
"\n"
"Konteks: Salin termin pembayaran dari penerimaan '%s'\n"
"ID Database: %s\n"
"Masalah: Penerimaan tujuan berikut tidak dapat menerima termin pembayaran:\n"
"%s\n"
"Solusi: Batalkan pilihan penerimaan yang tercantum, atau pastikan penerimaan tersebut berstatus draf, diizinkan oleh\n"
"kebijakan salin termin pembayaran, dan memiliki semester akademik/sekolah/tingkat yang sama dengan\n"
"sumber\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Create customer invoice from payment term\n"
"Database ID: %s\n"
"Problem: Payment term '%s' has no invoiceable detail line -- every line was "
"voided\n"
"Solution: Nothing to invoice; the amount was already billed on the term it "
"moved to\n"
msgstr ""
"\n"
"Konteks: Buat faktur pelanggan dari termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Syarat pembayaran '%s' tidak memiliki baris detail yang dapat difakturkan -- semua baris telah dialihkan\n"
"Solusi: Tidak ada yang dapat difakturkan; jumlahnya sudah ditagihkan pada syarat yang menjadi tujuannya\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice\n"
"Database ID: %s\n"
"Problem: Document is not allowed to create due invoice\n"
"Solution: Check create due invoice policy prerequisite\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo\n"
"ID Database: %s\n"
"Masalah: Dokumen tidak diizinkan membuat faktur jatuh tempo\n"
"Solusi: Periksa prasyarat kebijakan buat faktur jatuh tempo\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/wizards/school_admission_create_due_invoice.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice for admissions\n"
"Database ID: %s\n"
"Problem: Date Start '%s' is later than Date End '%s'\n"
"Solution: Choose a Date Start that is not later than Date End\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo untuk penerimaan\n"
"ID Database: %s\n"
"Masalah: Tanggal Mulai '%s' lebih lambat dari Tanggal Selesai '%s'\n"
"Solusi: Pilih Tanggal Mulai yang tidak lebih lambat dari Tanggal Selesai\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/wizards/school_admission_create_due_invoice.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice for admissions\n"
"Database ID: %s\n"
"Problem: No admission selected\n"
"Solution: Select at least one admission from the list view before running "
"this wizard\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo untuk penerimaan\n"
"ID Database: %s\n"
"Masalah: Tidak ada penerimaan yang dipilih\n"
"Solusi: Pilih minimal satu penerimaan dari tampilan daftar sebelum menjalankan wizard ini\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/wizards/school_admission_create_due_invoice.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice for admissions\n"
"Database ID: %s\n"
"Problem: The following admission(s) are not allowed to create due invoice:\n"
"%s\n"
"Solution: Deselect the listed admission(s), or make sure they are open and "
"allowed\n"
"by the create due invoice policy\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo untuk penerimaan\n"
"ID Database: %s\n"
"Masalah: Penerimaan berikut tidak diizinkan membuat faktur jatuh tempo:\n"
"%s\n"
"Solusi: Batalkan pilihan penerimaan yang tercantum, atau pastikan penerimaan tersebut terbuka dan diizinkan\n"
"oleh kebijakan buat faktur jatuh tempo\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/wizards/school_admission_create_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Create enrollment from admission\n"
"Database ID: %s\n"
"Problem: Admission has no linked school student yet\n"
"Solution: Open the admission first so its school student is created\n"
msgstr ""
"\n"
"Konteks: Buat pendaftaran dari penerimaan\n"
"ID Database: %s\n"
"Masalah: Penerimaan belum memiliki siswa sekolah yang terhubung\n"
"Solusi: Buka penerimaan terlebih dahulu agar siswa sekolahnya dibuat\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission.py:0
#, python-format
msgid ""
"\n"
"Context: Create student profile\n"
"Database ID: %s\n"
"Problem: Admission '%s' already has a student profile\n"
"Solution: Open the student profile from the Result tab instead of creating a "
"new one\n"
msgstr ""
"\n"
"Konteks: Buat profil siswa\n"
"ID Database: %s\n"
"Masalah: Penerimaan '%s' sudah memiliki profil siswa\n"
"Solusi: Buka profil siswa dari tab Hasil, bukan membuat yang baru\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Delete customer invoice of payment term\n"
"Database ID: %s\n"
"Problem: Customer invoice '%s' is not draft anymore and cannot be deleted\n"
"Solution: Use Disconnect Invoice to detach it from the payment term instead\n"
msgstr ""
"\n"
"Konteks: Hapus faktur pelanggan dari termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Faktur pelanggan '%s' tidak lagi berstatus draf dan tidak dapat dihapus\n"
"Solusi: Gunakan Lepaskan Faktur untuk melepaskannya dari termin pembayaran\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Delete payment term\n"
"Database ID: %s\n"
"Problem: Payment term '%s' is locked and cannot be deleted\n"
"Solution: Locked payment terms are permanent; create a new one via addendum "
"instead\n"
msgstr ""
"\n"
"Konteks: Hapus termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Syarat pembayaran '%s' terkunci dan tidak dapat dihapus\n"
"Solusi: Syarat pembayaran yang terkunci bersifat permanen; buat yang baru melalui addendum\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission_payment_term_detail.py:0
#, python-format
msgid ""
"\n"
"Context: Delete payment term detail\n"
"Database ID: %s\n"
"Problem: Payment term detail '%s' is locked and cannot be deleted\n"
"Solution: Locked detail lines are permanent; create a new one via the "
"addendum mechanism\n"
msgstr ""
"\n"
"Konteks: Hapus detail termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Detail termin pembayaran '%s' terkunci dan tidak dapat dihapus\n"
"Solusi: Baris detail yang terkunci bersifat permanen; buat yang baru melalui mekanisme addendum\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Update payment term\n"
"Database ID: %s\n"
"Problem: Payment term '%s' is locked and cannot be modified\n"
"Solution: Add a new payment term via the addendum mechanism instead of "
"editing this one\n"
msgstr ""
"\n"
"Konteks: Perbarui termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Syarat pembayaran '%s' terkunci dan tidak dapat diubah\n"
"Solusi: Tambahkan termin pembayaran baru melalui mekanisme addendum, bukan mengubah yang ini\n"

#. module: ssi_school_admission
#: code:addons/ssi_school_admission/models/school_admission_payment_term_detail.py:0
#, python-format
msgid ""
"\n"
"Context: Update payment term detail\n"
"Database ID: %s\n"
"Problem: Payment term detail '%s' is locked and cannot be modified\n"
"Solution: Add a new detail line via the addendum mechanism instead of "
"editing this one\n"
msgstr ""
"\n"
"Konteks: Perbarui detail termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Detail termin pembayaran '%s' terkunci dan tidak dapat diubah\n"
"Solusi: Tambahkan baris detail baru melalui mekanisme addendum, bukan mengubah yang ini\n"

