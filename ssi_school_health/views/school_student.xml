<odoo>

<record id="school_student_view_form_health" model="ir.ui.view">
    <field name="name">school_student form - health</field>
    <field name="model">school_student</field>
    <field name="inherit_id" ref="ssi_school.school_student_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook" position="inside">
                <page name="health" string="Health">
                    <group
                            name="health_latest_measurement"
                            string="Latest Measurements"
                            colspan="4"
                            col="2"
                        >
                        <field name="height" />
                        <field name="weight" />
                        <field name="head_circumference" />
                    </group>
                    <separator name="health_height" string="Height" />
                    <field name="height_ids" nolabel="1" colspan="4">
                        <tree editable="bottom">
                            <field name="date" />
                            <field name="value" />
                        </tree>
                        <form>
                            <group name="height_group_1">
                                <field name="date" />
                                <field name="value" />
                            </group>
                        </form>
                    </field>
                    <separator name="health_weight" string="Weight" />
                    <field name="weight_ids" nolabel="1" colspan="4">
                        <tree editable="bottom">
                            <field name="date" />
                            <field name="value" />
                        </tree>
                        <form>
                            <group name="weight_group_1">
                                <field name="date" />
                                <field name="value" />
                            </group>
                        </form>
                    </field>
                    <separator
                            name="health_head_circumference"
                            string="Head Circumference"
                        />
                    <field name="head_circumference_ids" nolabel="1" colspan="4">
                        <tree editable="bottom">
                            <field name="date" />
                            <field name="value" />
                        </tree>
                        <form>
                            <group name="head_circumference_group_1">
                                <field name="date" />
                                <field name="value" />
                            </group>
                        </form>
                    </field>
                    <separator name="health_allergy" string="Allergies" />
                    <field name="allergy_ids" nolabel="1" colspan="4">
                        <tree editable="bottom">
                            <field name="allergen_id" />
                            <field name="severity" />
                            <field name="reaction_ids" widget="many2many_tags" />
                            <field name="note" />
                        </tree>
                        <form>
                            <group name="allergy_group_1">
                                <field name="allergen_id" />
                                <field name="severity" />
                                <field name="reaction_ids" widget="many2many_tags" />
                                <field name="note" />
                            </group>
                        </form>
                    </field>
                    <separator name="health_disease_history" string="Disease History" />
                    <field name="disease_history_ids" nolabel="1" colspan="4">
                        <tree editable="bottom">
                            <field name="disease_id" />
                            <field name="date_diagnosed" />
                            <field name="date_recovered" />
                            <field name="note" />
                        </tree>
                        <form>
                            <group name="disease_history_group_1">
                                <field name="disease_id" />
                                <field name="date_diagnosed" />
                                <field name="date_recovered" />
                                <field name="note" />
                            </group>
                        </form>
                    </field>
                    <separator name="health_medication" string="Medications" />
                    <field name="medication_ids" nolabel="1" colspan="4">
                        <tree editable="bottom">
                            <field name="medication_id" />
                            <field name="dose" />
                            <field name="frequency" />
                            <field name="route" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="is_ongoing" />
                            <field name="instruction" />
                            <field name="disease_history_id" optional="hide" />
                        </tree>
                        <form>
                            <group name="medication_group_1">
                                <field name="medication_id" />
                                <field name="dose" />
                                <field name="frequency" />
                                <field name="route" />
                                <field name="date_start" />
                                <field name="date_end" />
                                <field name="is_ongoing" />
                                <field name="instruction" />
                                <field name="disease_history_id" />
                            </group>
                        </form>
                    </field>
                    <group
                            name="health_provider_summary"
                            string="Health Provider Summary"
                            colspan="4"
                            col="2"
                        >
                        <field name="family_doctor_id" />
                        <field name="health_facility_id" />
                    </group>
                    <separator name="health_provider" string="Health Providers" />
                    <field name="health_provider_ids" nolabel="1" colspan="4">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="provider_id" />
                            <field name="role_id" />
                            <field name="date_start" />
                            <field name="note" />
                        </tree>
                        <form>
                            <group name="health_provider_group_1">
                                <field name="sequence" />
                                <field name="provider_id" />
                                <field name="role_id" />
                                <field name="date_start" />
                                <field name="note" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

</odoo>
