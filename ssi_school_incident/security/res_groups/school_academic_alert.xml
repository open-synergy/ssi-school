<odoo>
<!-- Workflow Groups: Viewer -> User -> Validator. Category is shared with
     school_incident's own handling-tier groups
     (school_incident_workflow_module_category) by design decision: no new
     ir.module.category is created for this model. -->
<record id="school_academic_alert_viewer_group" model="res.groups">
    <field name="name">Academic Alert Viewer</field>
    <field name="category_id" ref="school_incident_workflow_module_category" />
</record>

<record id="school_academic_alert_user_group" model="res.groups">
    <field name="name">Academic Alert User</field>
    <field name="category_id" ref="school_incident_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('school_academic_alert_viewer_group'))]" />
</record>

<record id="school_academic_alert_validator_group" model="res.groups">
    <field name="name">Academic Alert Validator</field>
    <field name="category_id" ref="school_incident_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('school_academic_alert_user_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

</odoo>
