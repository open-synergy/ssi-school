<odoo>

<record id="school_incident_wizard_escalate_view_form" model="ir.ui.view">
    <field name="name">school_incident.wizard_escalate - form</field>
    <field name="model">school_incident.wizard_escalate</field>
    <field name="arch" type="xml">
        <form string="Escalate Incident">
            <group name="main" colspan="4" col="2">
                <field name="incident_id" />
                <field name="target_level" />
                <field
                        name="escalation_criteria_ids"
                        widget="many2many_tags"
                        domain="[('target_level', '=', target_level == '2' and 'level_2' or target_level == '3' and 'level_3' or False)]"
                        colspan="2"
                    />
                <field name="escalation_reason" nolabel="1" colspan="2" />
            </group>
            <footer>
                <button
                        name="action_escalate_wizard"
                        type="object"
                        string="Escalate"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record id="school_incident_wizard_escalate_action" model="ir.actions.act_window">
    <field name="name">Escalate Incident</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_incident.wizard_escalate</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="model_school_incident" />
</record>

</odoo>
