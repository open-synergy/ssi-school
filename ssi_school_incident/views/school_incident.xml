<odoo>
<record id="school_incident_view_search" model="ir.ui.view">
    <field name="name">school_incident - search</field>
    <field name="model">school_incident</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="student_id" />
                <field name="incident_type_id" />
                <field name="handling_level" />
                <field name="contact_method" />
                <field name="resolution_status" />
                <filter
                        name="dom_overdue"
                        string="Overdue"
                        domain="[('is_overdue', '=', True)]"
                    />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_incident_type_id"
                            string="Incident Type"
                            context="{'group_by': 'incident_type_id'}"
                        />
                    <filter
                            name="group_by_handling_level"
                            string="Handling Level"
                            context="{'group_by': 'handling_level'}"
                        />
                    <filter
                            name="group_by_student_id"
                            string="Student"
                            context="{'group_by': 'student_id'}"
                        />
                    <filter
                            name="group_by_resolution_status"
                            string="Resolution Status"
                            context="{'group_by': 'resolution_status'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_incident_view_tree" model="ir.ui.view">
    <field name="name">school_incident - tree</field>
    <field name="model">school_incident</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">is_overdue</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date_incident" />
                <field name="student_id" />
                <field name="incident_type_id" />
                <field name="handling_level" />
                <field name="resolution_status" />
                <field name="is_overdue" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_incident_view_form" model="ir.ui.view">
    <field name="name">school_incident - form</field>
    <field name="model">school_incident</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                        name="%(school_incident_wizard_escalate_action)d"
                        type="action"
                        string="Escalate"
                        attrs="{'invisible': [('escalate_ok', '=', False)]}"
                        groups="school_incident_officer_group"
                    />
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="student_id" />
                <field name="enrollment_id" domain="[('student_id','=',student_id)]" />
                <field name="grade_class_id" />
                <field name="parent_partner_id" />
                <field name="incident_type_id" />
                <field name="handling_level" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date_incident" />
                <field name="handled_by_id" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="detail" string="Incident Detail">
                    <group name="incident_what_group" string="What Happened">
                        <field name="description" nolabel="1" />
                    </group>
                    <group name="incident_handling_group" string="First Contact">
                        <field name="contact_method" />
                        <field name="date_first_contact" />
                    </group>
                    <group name="incident_action_group" string="Action Taken">
                        <field name="action_taken" nolabel="1" />
                    </group>
                    <group name="incident_resolution_group" string="Resolution">
                        <field name="resolution_status" />
                        <field name="date_resolved" />
                        <field name="first_contact_deadline" />
                        <field name="resolution_deadline" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='detail']" position="after">
                <page name="parent_contact" string="Parent Contacts">
                    <field name="parent_contact_ids">
                        <tree editable="bottom">
                            <field name="contact_datetime" />
                            <field name="contact_method" />
                            <field name="contacted_by_id" />
                            <field name="parent_partner_id" />
                            <field name="summary" />
                            <field name="is_first_contact" readonly="1" />
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='parent_contact']" position="after">
                <page name="escalation" string="Escalation">
                    <group name="escalation_group" string="Last Escalation">
                        <field name="escalated_to_level" />
                        <field name="escalated_by_id" />
                        <field name="escalation_date" />
                    </group>
                    <group
                            name="escalation_criteria_group"
                            string="Escalation Criteria"
                        >
                        <field
                                name="escalation_criteria_ids"
                                nolabel="1"
                                readonly="1"
                                widget="many2many_tags"
                            />
                    </group>
                    <group name="escalation_reason_group" string="Escalation Reason">
                        <field name="escalation_reason" nolabel="1" readonly="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_incident_action" model="ir.actions.act_window">
    <field name="name">Incidents</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_incident</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_incident_menu"
        name="Incidents"
        parent="menu_incident_root"
        action="school_incident_action"
        groups="school_incident_user_group"
        sequence="10"
    />

</odoo>
