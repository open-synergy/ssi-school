<odoo>
<record id="school_incident_escalation_criteria_view_search" model="ir.ui.view">
    <field name="name">school_incident_escalation_criteria - search</field>
    <field name="model">school_incident_escalation_criteria</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_target_level"
                            string="Target Level"
                            context="{'group_by': 'target_level'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_incident_escalation_criteria_view_tree" model="ir.ui.view">
    <field name="name">school_incident_escalation_criteria - tree</field>
    <field name="model">school_incident_escalation_criteria</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="before">
                <field name="sequence" widget="handle" />
            </xpath>
            <xpath expr="//field[@name='code']" position="after">
                <field name="target_level" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_incident_escalation_criteria_view_form" model="ir.ui.view">
    <field name="name">school_incident_escalation_criteria - form</field>
    <field name="model">school_incident_escalation_criteria</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="sequence" />
            </xpath>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="escalation" string="Escalation">
                    <group name="escalation_group_1" string="Escalation Criterion">
                        <field name="target_level" />
                        <field name="verification_method" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_incident_escalation_criteria_action" model="ir.actions.act_window">
    <field name="name">Incident Escalation Criteria</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_incident_escalation_criteria</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_incident_escalation_criteria_menu"
        name="Escalation Criteria"
        parent="menu_incident_configuration"
        action="school_incident_escalation_criteria_action"
        groups="school_incident_manager_group"
        sequence="20"
    />

</odoo>
