<odoo>
<record id="school_academic_alert_level_view_search" model="ir.ui.view">
    <field name="name">school_academic_alert_level - search</field>
    <field name="model">school_academic_alert_level</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="color" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_color"
                            string="Color"
                            context="{'group_by': 'color'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_academic_alert_level_view_tree" model="ir.ui.view">
    <field name="name">school_academic_alert_level - tree</field>
    <field name="model">school_academic_alert_level</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="color" />
                <field name="sequence" />
                <field name="sla_text" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_academic_alert_level_view_form" model="ir.ui.view">
    <field name="name">school_academic_alert_level - form</field>
    <field name="model">school_academic_alert_level</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="trigger" string="Trigger">
                    <group name="trigger_group_1" string="Severity">
                        <field name="color" />
                        <field name="sequence" />
                    </group>
                    <group name="trigger_group_2" string="Trigger Rule">
                        <field name="python_code" nolabel="1" />
                    </group>
                </page>
                <page name="action" string="Action &amp; SLA">
                    <group name="action_group_1" string="Action Guideline">
                        <field name="action_guideline" nolabel="1" />
                    </group>
                    <group name="action_group_2" string="SLA">
                        <field name="sla_text" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_academic_alert_level_action" model="ir.actions.act_window">
    <field name="name">Academic Alert Levels</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_academic_alert_level</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_academic_alert_level_menu"
        name="Academic Alert Levels"
        parent="menu_incident_configuration"
        action="school_academic_alert_level_action"
        groups="school_incident_manager_group"
        sequence="20"
    />

</odoo>
