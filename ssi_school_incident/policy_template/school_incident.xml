<odoo>
<record id="policy_template_school_incident" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_school_incident" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','school_incident'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- Confirm -->
<record id="policy_template_school_incident_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_incident" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_incident'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_incident'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('school_incident_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Done -->
<record id="policy_template_school_incident_done" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_incident" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_incident'),('name','=','done_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_incident'),('value','=','open')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('school_incident_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Cancel -->
<record id="policy_template_school_incident_cancel" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_incident" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_incident'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_incident'),('value','in',['draft','confirm','open'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('school_incident_officer_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

