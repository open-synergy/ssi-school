<odoo>

<record
        id="policy_template_school_enrollment_create_invoice_export"
        model="policy.template_detail"
    >
    <field name="template_id" ref="ssi_school.policy_template_school_enrollment" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_enrollment'),('name','=','create_invoice_export_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_enrollment'),('value','in',['open','done'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('ssi_school.school_enrollment_user_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>

</odoo>
