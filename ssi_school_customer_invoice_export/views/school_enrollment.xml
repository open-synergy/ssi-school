<odoo>

<record id="school_enrollment_view_form_invoice_export" model="ir.ui.view">
    <field name="name">school_enrollment form - invoice export</field>
    <field name="model">school_enrollment</field>
    <field name="inherit_id" ref="ssi_school.school_enrollment_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath
                    expr="//button[@name='action_open_create_due_invoice_wizard']"
                    position="after"
                >
                <button
                        name="action_open_create_invoice_export_wizard"
                        type="object"
                        string="Create Invoice Export"
                        attrs="{'invisible':[('create_invoice_export_ok','=',False)]}"
                    />
            </xpath>
            <xpath expr="//group[@name='policy_2']" position="inside">
                <field name="create_invoice_export_ok" />
            </xpath>
        </data>
    </field>
</record>

</odoo>
