<odoo>
<record id="school_branch_view_search" model="ir.ui.view">
    <field name="name">school_branch - search</field>
    <field name="model">school_branch</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="company_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_company_id"
                            string="Center"
                            context="{'group_by': 'company_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_branch_view_tree" model="ir.ui.view">
    <field name="name">school_branch - tree</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="model">school_branch</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="company_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_branch_open_school_action" model="ir.actions.act_window">
    <field name="name">School Units</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('branch_id', '=', active_id)]</field>
    <field name="context">{'default_branch_id': active_id}</field>
</record>

<record id="school_branch_view_form" model="ir.ui.view">
    <field name="name">school_branch - form</field>
    <field name="model">school_branch</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="company_id" />
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                        class="oe_stat_button"
                        type="action"
                        name="%(school_branch_open_school_action)d"
                        icon="fa-university"
                    >
                    <field
                            name="school_count"
                            string="School Units"
                            widget="statinfo"
                        />
                </button>
            </xpath>
        </data>
    </field>
</record>

<record id="school_branch_action" model="ir.actions.act_window">
    <field name="name">Branches</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_branch</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_branch_menu"
        name="Branches"
        parent="menu_school_configuration"
        action="school_branch_action"
        groups="school_branch_group"
        sequence="20"
    />

</odoo>
