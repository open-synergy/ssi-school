<odoo>

<record id="school_enrollment_fee_analysis_view_search" model="ir.ui.view">
    <field name="name">school_enrollment_fee_analysis - search</field>
    <field name="model">school_enrollment_fee_analysis</field>
    <field name="arch" type="xml">
        <search string="Enrollment Fee Analysis">
            <field name="enrollment_id" />
            <field name="student_id" />
            <field name="school_id" />
            <field name="academic_year_id" />
            <field name="academic_term_id" />
            <field name="grade_id" />
            <field name="product_id" />
            <filter
                    name="filter_term_draft"
                    string="Draft Term"
                    domain="[('term_state','=','draft')]"
                />
            <filter
                    name="filter_term_uninvoiced"
                    string="Uninvoiced Term"
                    domain="[('term_state','=','uninvoiced')]"
                />
            <filter
                    name="filter_term_invoiced"
                    string="Invoiced Term"
                    domain="[('term_state','=','invoiced')]"
                />
            <separator />
            <filter
                    name="filter_enrollment_open"
                    string="Enrollment On Progress"
                    domain="[('enrollment_state','=','open')]"
                />
            <filter
                    name="filter_enrollment_done"
                    string="Enrollment Done"
                    domain="[('enrollment_state','=','done')]"
                />
            <group expand="0" string="Group By">
                <filter
                        name="group_by_academic_year_id"
                        string="Academic Year"
                        context="{'group_by': 'academic_year_id'}"
                    />
                <filter
                        name="group_by_academic_term_id"
                        string="Academic Term"
                        context="{'group_by': 'academic_term_id'}"
                    />
                <filter
                        name="group_by_school_id"
                        string="School"
                        context="{'group_by': 'school_id'}"
                    />
                <filter
                        name="group_by_grade_id"
                        string="Grade"
                        context="{'group_by': 'grade_id'}"
                    />
                <filter
                        name="group_by_product_id"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
            </group>
        </search>
    </field>
</record>

<record id="school_enrollment_fee_analysis_view_pivot" model="ir.ui.view">
    <field name="name">school_enrollment_fee_analysis - pivot</field>
    <field name="model">school_enrollment_fee_analysis</field>
    <field name="arch" type="xml">
        <pivot string="Enrollment Fee Analysis" disable_linking="True">
            <field name="academic_year_id" type="row" />
            <field name="academic_term_id" type="row" />
            <field name="product_id" type="row" />
            <field name="uom_quantity" type="measure" />
            <field name="price_subtotal" type="measure" />
            <field name="price_tax" type="measure" />
            <field name="price_total" type="measure" />
        </pivot>
    </field>
</record>

<record id="school_enrollment_fee_analysis_view_tree" model="ir.ui.view">
    <field name="name">school_enrollment_fee_analysis - tree</field>
    <field name="model">school_enrollment_fee_analysis</field>
    <field name="arch" type="xml">
        <tree create="false" edit="false" delete="false">
            <field name="enrollment_id" />
            <field name="student_id" />
            <field name="school_id" />
            <field name="academic_year_id" />
            <field name="academic_term_id" />
            <field name="grade_id" />
            <field name="product_id" />
            <field name="term_name" />
            <field name="term_state" />
            <field name="uom_quantity" />
            <field name="price_subtotal" sum="Untaxed" />
            <field name="price_tax" sum="Tax" />
            <field name="price_total" sum="Total" />
        </tree>
    </field>
</record>

<record id="school_enrollment_fee_analysis_action" model="ir.actions.act_window">
    <field name="name">Enrollment Fee Analysis</field>
    <field name="res_model">school_enrollment_fee_analysis</field>
    <field name="view_mode">pivot,tree</field>
    <field name="search_view_id" ref="school_enrollment_fee_analysis_view_search" />
</record>

<menuitem
        id="school_enrollment_fee_analysis_menu"
        name="Enrollment Fee Analysis"
        parent="menu_school_report"
        action="school_enrollment_fee_analysis_action"
        groups="school_enrollment_fee_analysis_group"
    />

</odoo>
