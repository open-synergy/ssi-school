#. module: ssi_school
#: code:addons/ssi_school/models/customer_invoice.py:0
#, python-format
msgid ""
"\n"
"Context: Cancel customer invoice\n"
"Database ID: %s\n"
"Problem: Line '%s' was already released by the Revenue Recognition of "
"enrollment '%s'\n"
"Solution: Revenue Recognition entries cannot be undone by cancelling this "
"invoice\n"
msgstr ""
"\n"
"Konteks: Batalkan faktur pelanggan\n"
"ID Database: %s\n"
"Masalah: Baris '%s' sudah diakui oleh Pengakuan Pendapatan pendaftaran '%s'\n"
"Solusi: Entri Pengakuan Pendapatan tidak dapat dibatalkan dengan membatalkan faktur ini\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Cancel enrollment\n"
"Database ID: %s\n"
"Problem: Payment term '%s' is already linked to an invoice\n"
"Solution: Delete or disconnect the invoice on the payment term before "
"cancelling this enrollment\n"
msgstr ""
"\n"
"Konteks: Batalkan pendaftaran\n"
"ID Database: %s\n"
"Masalah: Syarat pembayaran '%s' sudah terhubung ke faktur\n"
"Solusi: Hapus atau lepaskan faktur pada termin pembayaran sebelum membatalkan pendaftaran ini\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student_mutation.py:0
#, python-format
msgid ""
"\n"
"Context: Change class mutation state into %s\n"
"Database ID: %s\n"
"Problem: Another mutation for enrollment '%s' is already draft or\n"
"waiting for approval\n"
"Solution: Complete, reject, or cancel the other mutation before\n"
"confirming this one\n"
msgstr ""
"\n"
"Konteks: Ubah status mutasi kelas menjadi %s\n"
"ID Database: %s\n"
"Masalah: Mutasi lain untuk pendaftaran '%s' sudah berstatus draf atau\n"
"menunggu persetujuan\n"
"Solusi: Selesaikan, tolak, atau batalkan mutasi lain sebelum\n"
"mengonfirmasi mutasi ini\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student_mutation.py:0
#, python-format
msgid ""
"\n"
"Context: Change class mutation state into %s\n"
"Database ID: %s\n"
"Problem: Enrollment '%s' is not in open state\n"
"Solution: The enrollment must be open before this mutation can be\n"
"confirmed or completed\n"
msgstr ""
"\n"
"Konteks: Ubah status mutasi kelas menjadi %s\n"
"ID Database: %s\n"
"Masalah: Pendaftaran '%s' tidak dalam status terbuka\n"
"Solusi: Pendaftaran harus terbuka sebelum mutasi ini dapat\n"
"dikonfirmasi atau diselesaikan\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student.py:0
#, python-format
msgid ""
"\n"
"Context: Change student state\n"
"Database ID: %s\n"
"Problem: State cannot change from '%s' to '%s'\n"
"Solution: Follow the allowed student state transition sequence\n"
msgstr ""
"\n"
"Konteks: Ubah status siswa\n"
"ID Database: %s\n"
"Masalah: Status tidak dapat berubah dari '%s' ke '%s'\n"
"Solusi: Ikuti urutan transisi status siswa yang diizinkan\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student_mutation.py:0
#, python-format
msgid ""
"\n"
"Context: Complete class mutation\n"
"Database ID: %s\n"
"Problem: Destination Grade Class '%s' is at full capacity (%s/%s\n"
"students)\n"
"Solution: Choose a different destination class or increase its\n"
"capacity\n"
msgstr ""
"\n"
"Konteks: Selesaikan mutasi kelas\n"
"ID Database: %s\n"
"Masalah: Kelas Tingkat tujuan '%s' sudah penuh (%s/%s\n"
"siswa)\n"
"Solusi: Pilih kelas tujuan lain atau tambah\n"
"kapasitasnya\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student_mutation.py:0
#, python-format
msgid ""
"\n"
"Context: Complete class mutation\n"
"Database ID: %s\n"
"Problem: Enrollment '%s' is no longer open\n"
"Solution: Cancel this mutation; the enrollment must stay open until\n"
"the mutation is completed\n"
msgstr ""
"\n"
"Konteks: Selesaikan mutasi kelas\n"
"ID Database: %s\n"
"Masalah: Pendaftaran '%s' tidak lagi terbuka\n"
"Solusi: Batalkan mutasi ini; pendaftaran harus tetap terbuka hingga\n"
"mutasi selesai\n"

#. module: ssi_school
#: code:addons/ssi_school/wizards/school_enrollment_copy_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Copy payment terms between enrollments\n"
"Database ID: %s\n"
"Problem: No target enrollment selected\n"
"Solution: Select at least one draft enrollment from the list view before "
"running this wizard\n"
msgstr ""
"\n"
"Konteks: Salin termin pembayaran antar pendaftaran\n"
"ID Database: %s\n"
"Masalah: Belum ada pendaftaran tujuan yang dipilih\n"
"Solusi: Pilih setidaknya satu pendaftaran draf dari tampilan daftar sebelum menjalankan wizard ini\n"

#. module: ssi_school
#: code:addons/ssi_school/wizards/school_enrollment_copy_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Copy payment terms from enrollment '%s'\n"
"Database ID: %s\n"
"Problem: The following target enrollment(s) cannot receive payment terms:\n"
"%s\n"
"Solution: Deselect the listed enrollment(s), or make sure they are draft, "
"allowed by\n"
"the copy payment term policy, and share the same academic term/school/grade "
"as the\n"
"source\n"
msgstr ""
"\n"
"Konteks: Salin termin pembayaran dari pendaftaran '%s'\n"
"ID Database: %s\n"
"Masalah: Pendaftaran tujuan berikut tidak dapat menerima termin pembayaran:\n"
"%s\n"
"Solusi: Batalkan pilihan pendaftaran yang tercantum, atau pastikan statusnya draf, diizinkan oleh\n"
"kebijakan salin termin pembayaran, dan memiliki periode akademik/sekolah/tingkat yang sama dengan\n"
"sumber\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Create customer invoice from payment term\n"
"Database ID: %s\n"
"Problem: Payment term '%s' has no invoiceable detail line -- every line was "
"voided\n"
"Solution: Nothing to invoice; the amount was already billed on the term it "
"moved to\n"
msgstr ""
"\n"
"Konteks: Buat faktur pelanggan dari termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Syarat pembayaran '%s' tidak memiliki baris detail yang dapat difakturkan -- semua baris telah dialihkan\n"
"Solusi: Tidak ada yang dapat difakturkan; jumlahnya sudah ditagihkan pada syarat yang menjadi tujuannya\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice\n"
"Database ID: %s\n"
"Problem: Document is not allowed to create due invoice\n"
"Solution: Check create due invoice policy prerequisite\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo\n"
"ID Database: %s\n"
"Masalah: Dokumen tidak diizinkan membuat faktur jatuh tempo\n"
"Solusi: Periksa prasyarat kebijakan buat faktur jatuh tempo\n"

#. module: ssi_school
#: code:addons/ssi_school/wizards/school_enrollment_create_due_invoice.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice for enrollments\n"
"Database ID: %s\n"
"Problem: Date Start '%s' is later than Date End '%s'\n"
"Solution: Choose a Date Start that is not later than Date End\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo untuk pendaftaran\n"
"ID Database: %s\n"
"Masalah: Tanggal Mulai '%s' lebih akhir dari Tanggal Selesai '%s'\n"
"Solusi: Pilih Tanggal Mulai yang tidak lebih akhir dari Tanggal Selesai\n"

#. module: ssi_school
#: code:addons/ssi_school/wizards/school_enrollment_create_due_invoice.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice for enrollments\n"
"Database ID: %s\n"
"Problem: No enrollment selected\n"
"Solution: Select at least one enrollment from the list view before running "
"this wizard\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo untuk pendaftaran\n"
"ID Database: %s\n"
"Masalah: Belum ada pendaftaran yang dipilih\n"
"Solusi: Pilih setidaknya satu pendaftaran dari tampilan daftar sebelum menjalankan wizard ini\n"

#. module: ssi_school
#: code:addons/ssi_school/wizards/school_enrollment_create_due_invoice.py:0
#, python-format
msgid ""
"\n"
"Context: Create due invoice for enrollments\n"
"Database ID: %s\n"
"Problem: The following enrollment(s) are not allowed to create due invoice:\n"
"%s\n"
"Solution: Deselect the listed enrollment(s), or make sure they are open and "
"allowed\n"
"by the create due invoice policy\n"
msgstr ""
"\n"
"Konteks: Buat faktur jatuh tempo untuk pendaftaran\n"
"ID Database: %s\n"
"Masalah: Pendaftaran berikut tidak diizinkan membuat faktur jatuh tempo:\n"
"%s\n"
"Solusi: Batalkan pilihan pendaftaran yang tercantum, atau pastikan statusnya terbuka dan diizinkan\n"
"oleh kebijakan buat faktur jatuh tempo\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student.py:0
#, python-format
msgid ""
"\n"
"Context: Create or update student\n"
"Database ID: %s\n"
"Problem: Duplicate code '%s' in school '%s'\n"
"Solution: Change the student code to be unique within the school\n"
msgstr ""
"\n"
"Konteks: Buat atau perbarui siswa\n"
"ID Database: %s\n"
"Masalah: Kode '%s' duplikat di sekolah '%s'\n"
"Solusi: Ubah kode siswa agar unik dalam sekolah\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Delete customer invoice of payment term\n"
"Database ID: %s\n"
"Problem: Customer invoice '%s' is not draft anymore and cannot be deleted\n"
"Solution: Use Disconnect Invoice to detach it from the payment term instead\n"
msgstr ""
"\n"
"Konteks: Hapus faktur pelanggan dari termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Faktur pelanggan '%s' tidak lagi berstatus draf dan tidak dapat dihapus\n"
"Solusi: Gunakan Lepaskan Faktur untuk melepaskannya dari termin pembayaran\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Delete payment term\n"
"Database ID: %s\n"
"Problem: Payment term '%s' is locked and cannot be deleted\n"
"Solution: Locked payment terms are permanent; create a new one via addendum "
"instead\n"
msgstr ""
"\n"
"Konteks: Hapus termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Syarat pembayaran '%s' terkunci dan tidak dapat dihapus\n"
"Solusi: Syarat pembayaran yang terkunci bersifat permanen; buat yang baru melalui addendum\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment_payment_term_detail.py:0
#, python-format
msgid ""
"\n"
"Context: Delete payment term detail\n"
"Database ID: %s\n"
"Problem: Payment term detail '%s' is locked and cannot be deleted\n"
"Solution: Locked detail lines are permanent; create a new one via the "
"addendum mechanism\n"
msgstr ""
"\n"
"Konteks: Hapus detail termin pembayaran\n"
"ID Database: %s\n"
"Masalah: Detail termin pembayaran '%s' terkunci dan tidak dapat dihapus\n"
"Solusi: Baris detail yang terkunci bersifat permanen; buat yang baru melalui mekanisme addendum\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Finish enrollment\n"
"Database ID: %s\n"
"Problem: Payment term '%s' has a customer invoice that is not yet Unpaid/"
"Paid\n"
"Solution: Confirm and open the customer invoice before finishing this "
"enrollment\n"
msgstr ""
"\n"
"Konteks: Selesaikan pendaftaran\n"
"ID Database: %s\n"
"Masalah: Syarat pembayaran '%s' memiliki faktur pelanggan yang belum berstatus Belum Dibayar/Lunas\n"
"Solusi: Konfirmasi dan buka faktur pelanggan sebelum menyelesaikan pendaftaran ini\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Finish enrollment\n"
"Database ID: %s\n"
"Problem: Revenue Recognition is enabled but no Recognition Journal is set\n"
"Solution: Select a Recognition Journal before finishing this enrollment\n"
msgstr ""
"\n"
"Konteks: Selesaikan pendaftaran\n"
"ID Database: %s\n"
"Masalah: Pengakuan Pendapatan aktif tetapi Jurnal Pengakuan belum diatur\n"
"Solusi: Pilih Jurnal Pengakuan sebelum menyelesaikan pendaftaran ini\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_homeroom.py:0
#, python-format
msgid ""
"\n"
"Context: Generate Homeroom enrollments\n"
"Database ID: %s\n"
"Problem: Enrollment(s) %s are no longer in draft state, but their\n"
"student is not in Candidate Students\n"
"Solution: Add the student(s) back to Candidate Students, or\n"
"cancel/adjust the enrollment(s) manually before generating\n"
msgstr ""
"\n"
"Konteks: Buat pendaftaran Wali Kelas\n"
"ID Database: %s\n"
"Masalah: Pendaftaran %s tidak lagi berstatus draf, tetapi\n"
"siswanya tidak ada dalam Calon Siswa\n"
"Solusi: Tambahkan kembali siswa ke Calon Siswa, atau\n"
"batalkan/sesuaikan pendaftaran secara manual sebelum membuat\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Open enrollment\n"
"Database ID: %s\n"
"Problem: Academic Term '%s' is not open for enrollment\n"
"Solution: Open the enrollment window on the academic term before opening "
"this enrollment\n"
msgstr ""
"\n"
"Konteks: Buka pendaftaran\n"
"ID Database: %s\n"
"Masalah: Periode Akademik '%s' belum dibuka untuk pendaftaran\n"
"Solusi: Buka jendela pendaftaran pada periode akademik sebelum membuka pendaftaran ini\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Open enrollment\n"
"Database ID: %s\n"
"Problem: Grade Class '%s' is at full capacity (%s/%s students)\n"
"Solution: Choose a different Grade Class or increase its capacity\n"
msgstr ""
"\n"
"Konteks: Buka pendaftaran\n"
"ID Database: %s\n"
"Masalah: Kelas Tingkat '%s' sudah penuh (%s/%s siswa)\n"
"Solusi: Pilih Kelas Tingkat lain atau tambah kapasitasnya\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Open enrollment\n"
"Database ID: %s\n"
"Problem: Student '%s' already has an active enrollment for term '%s'\n"
"Solution: Cancel or close the existing enrollment before opening a new one\n"
msgstr ""
"\n"
"Konteks: Buka pendaftaran\n"
"ID Database: %s\n"
"Masalah: Siswa '%s' sudah memiliki pendaftaran aktif untuk periode '%s'\n"
"Solusi: Batalkan atau tutup pendaftaran yang ada sebelum membuka yang baru\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_homeroom.py:0
#, python-format
msgid ""
"\n"
"Context: Set Homeroom academic term\n"
"Database ID: %s\n"
"Problem: Academic Term '%s' does not belong to Academic Year '%s'\n"
"Solution: Select an Academic Term that belongs to the selected Academic "
"Year\n"
msgstr ""
"\n"
"Konteks: Atur periode akademik Wali Kelas\n"
"ID Database: %s\n"
"Masalah: Periode Akademik '%s' tidak termasuk Tahun Ajaran '%s'\n"
"Solusi: Pilih Periode Akademik yang termasuk dalam Tahun Ajaran yang dipilih\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_homeroom.py:0
#, python-format
msgid ""
"\n"
"Context: Set Homeroom grade class\n"
"Database ID: %s\n"
"Problem: Grade Class '%s' does not match the selected Grade/School\n"
"Solution: Select a Grade Class that belongs to the selected Grade and "
"School\n"
msgstr ""
"\n"
"Konteks: Atur kelas tingkat Wali Kelas\n"
"ID Database: %s\n"
"Masalah: Kelas Tingkat '%s' tidak sesuai dengan Tingkat/Sekolah yang dipilih\n"
"Solusi: Pilih Kelas Tingkat yang termasuk dalam Tingkat dan Sekolah yang dipilih\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_academic_term.py:0
#, python-format
msgid ""
"\n"
"Context: Set academic term dates\n"
"Database ID: %s\n"
"Problem: Date End must be after Date Start\n"
"Solution: Set Date End to a date later than Date Start\n"
msgstr ""
"\n"
"Konteks: Atur tanggal periode akademik\n"
"ID Database: %s\n"
"Masalah: Tanggal Selesai harus setelah Tanggal Mulai\n"
"Solusi: Atur Tanggal Selesai ke tanggal yang lebih akhir dari Tanggal Mulai\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_academic_term.py:0
#, python-format
msgid ""
"\n"
"Context: Set academic term dates\n"
"Database ID: %s\n"
"Problem: Term dates fall outside the range of academic year '%s' (%s - %s)\n"
"Solution: Set term dates within the academic year's date range\n"
msgstr ""
"\n"
"Konteks: Atur tanggal periode akademik\n"
"ID Database: %s\n"
"Masalah: Tanggal periode berada di luar rentang tahun ajaran '%s' (%s - %s)\n"
"Solusi: Atur tanggal periode dalam rentang tanggal tahun ajaran\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_academic_year.py:0
#, python-format
msgid ""
"\n"
"Context: Set academic year dates\n"
"Database ID: %s\n"
"Problem: Date End must be after Date Start\n"
"Solution: Set Date End to a date later than Date Start\n"
msgstr ""
"\n"
"Konteks: Atur tanggal tahun ajaran\n"
"ID Database: %s\n"
"Masalah: Tanggal Selesai harus setelah Tanggal Mulai\n"
"Solusi: Atur Tanggal Selesai ke tanggal yang lebih akhir dari Tanggal Mulai\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student_mutation.py:0
#, python-format
msgid ""
"\n"
"Context: Set class mutation destination\n"
"Database ID: %s\n"
"Problem: Destination Grade Class '%s' does not belong to the same\n"
"Grade/School as the enrollment\n"
"Solution: Select a Destination Grade Class within the same Grade and\n"
"School as the enrollment\n"
msgstr ""
"\n"
"Konteks: Atur tujuan mutasi kelas\n"
"ID Database: %s\n"
"Masalah: Kelas Tingkat tujuan '%s' tidak termasuk Tingkat/Sekolah\n"
"yang sama dengan pendaftaran\n"
"Solusi: Pilih Kelas Tingkat tujuan dalam Tingkat dan Sekolah\n"
"yang sama dengan pendaftaran\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_student_mutation.py:0
#, python-format
msgid ""
"\n"
"Context: Set class mutation destination\n"
"Database ID: %s\n"
"Problem: Destination Grade Class '%s' is the same as the current class\n"
"Solution: Select a different Grade Class as the mutation destination\n"
msgstr ""
"\n"
"Konteks: Atur tujuan mutasi kelas\n"
"ID Database: %s\n"
"Masalah: Kelas Tingkat tujuan '%s' sama dengan kelas saat ini\n"
"Solusi: Pilih Kelas Tingkat lain sebagai tujuan mutasi\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Set enrollment academic term\n"
"Database ID: %s\n"
"Problem: Academic Term '%s' does not belong to Academic Year '%s'\n"
"Solution: Select an Academic Term that belongs to the selected Academic "
"Year\n"
msgstr ""
"\n"
"Konteks: Atur periode akademik pendaftaran\n"
"ID Database: %s\n"
"Masalah: Periode Akademik '%s' tidak termasuk Tahun Ajaran '%s'\n"
"Solusi: Pilih Periode Akademik yang termasuk dalam Tahun Ajaran yang dipilih\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment.py:0
#, python-format
msgid ""
"\n"
"Context: Set enrollment grade class\n"
"Database ID: %s\n"
"Problem: Grade Class '%s' does not match the selected Grade/School\n"
"Solution: Select a Grade Class that belongs to the selected Grade and "
"School\n"
msgstr ""
"\n"
"Konteks: Atur kelas tingkat pendaftaran\n"
"ID Database: %s\n"
"Masalah: Kelas Tingkat '%s' tidak sesuai dengan Tingkat/Sekolah yang dipilih\n"
"Solusi: Pilih Kelas Tingkat yang termasuk dalam Tingkat dan Sekolah yang dipilih\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school.py:0
#, python-format
msgid ""
"\n"
"Context: Set school branch\n"
"Database ID: %s\n"
"Problem: Branch '%s' does not belong to Center '%s'\n"
"Solution: Select a Branch whose Center matches the school's Center\n"
msgstr ""
"\n"
"Konteks: Atur cabang sekolah\n"
"ID Database: %s\n"
"Masalah: Cabang '%s' tidak termasuk Pusat '%s'\n"
"Solusi: Pilih Cabang yang Pusatnya sama dengan Pusat sekolah\n"

#. module: ssi_school
#: code:addons/ssi_school/models/school_enrollment_payment_term.py:0
#, python-format
msgid ""
"\n"
"Context: Update payment term\n"
"Database ID: %s\n"
"Problem: Payment term '%s' is locked and cannot be modified\n"
"Solution: Add a new payment term via the addendum mechanism instead of "
"editing this one\n"
msgstr ""
"\n"
"Konteks: Perbarui termin pembayaran\n"
