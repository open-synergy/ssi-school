#. module: ssi_school_admission_customer_invoice_export
#: code:addons/ssi_school_admission_customer_invoice_export/models/school_admission.py:0
#, python-format
msgid ""
"\n"
"Context: Create invoice export\n"
"Database ID: %s\n"
"Problem: Document is not allowed to create invoice export\n"
"Solution: Check create invoice export policy prerequisite\n"
msgstr ""
"\n"
"Konteks: Buat ekspor faktur\n"
"ID Database: %s\n"
"Masalah: Dokumen tidak diizinkan untuk membuat ekspor faktur\n"
"Solusi: Periksa prasyarat kebijakan buat ekspor faktur\n"

#. module: ssi_school_admission_customer_invoice_export
#: code:addons/ssi_school_admission_customer_invoice_export/wizards/school_admission_create_invoice_export.py:0
#, python-format
msgid ""
"\n"
"Context: Create invoice export for admissions\n"
"Database ID: %s\n"
"Problem: No admission selected\n"
"Solution: Select at least one admission from the list view before running "
"this wizard\n"
msgstr ""
"\n"
"Konteks: Buat ekspor faktur untuk penerimaan\n"
"ID Database: %s\n"
"Masalah: Belum ada penerimaan yang dipilih\n"
"Solusi: Pilih minimal satu penerimaan dari tampilan daftar sebelum menjalankan wizard ini\n"

#. module: ssi_school_admission_customer_invoice_export
#: code:addons/ssi_school_admission_customer_invoice_export/wizards/school_admission_create_invoice_export.py:0
#, python-format
msgid ""
"\n"
"Context: Create invoice export for admissions\n"
"Database ID: %s\n"
"Problem: No exportable move found on the selected admission(s)\n"
"Solution: Select admission(s) that have at least one payment term with an "
"unpaid (open) customer invoice\n"
msgstr ""
"\n"
"Konteks: Buat ekspor faktur untuk penerimaan\n"
"ID Database: %s\n"
"Masalah: Tidak ditemukan faktur yang dapat diekspor pada penerimaan yang dipilih\n"
"Solusi: Pilih penerimaan yang memiliki minimal satu termin pembayaran dengan faktur pelanggan yang belum dibayar (terbuka)\n"

#. module: ssi_school_admission_customer_invoice_export
#: code:addons/ssi_school_admission_customer_invoice_export/wizards/school_admission_create_invoice_export.py:0
#, python-format
msgid ""
"\n"
"Context: Create invoice export for admissions\n"
"Database ID: %s\n"
"Problem: No summary row was produced for the exported invoices\n"
"Solution: Check the Journal/Partner/Product criteria on Type '%s'\n"
msgstr ""
"\n"
"Konteks: Buat ekspor faktur untuk penerimaan\n"
"ID Database: %s\n"
"Masalah: Tidak ada baris ringkasan yang dihasilkan untuk faktur yang diekspor\n"
"Solusi: Periksa kriteria Jurnal/Mitra/Produk pada Jenis '%s'\n"

#. module: ssi_school_admission_customer_invoice_export
#: code:addons/ssi_school_admission_customer_invoice_export/wizards/school_admission_create_invoice_export.py:0
#, python-format
msgid ""
"\n"
"Context: Create invoice export for admissions\n"
"Database ID: %s\n"
"Problem: The following admission(s) are not allowed to create invoice "
"export:\n"
"%s\n"
"Solution: Deselect the listed admission(s), or make sure they are open/done "
"and allowed\n"
"by the create invoice export policy\n"
msgstr ""
"\n"
"Konteks: Buat ekspor faktur untuk penerimaan\n"
"ID Database: %s\n"
"Masalah: Penerimaan berikut tidak diizinkan untuk membuat ekspor faktur:\n"
"%s\n"
"Solusi: Batalkan pilihan penerimaan yang tercantum, atau pastikan statusnya terbuka/selesai dan diizinkan\n"
"oleh kebijakan buat ekspor faktur\n"

#. module: ssi_school_admission_customer_invoice_export
#: code:addons/ssi_school_admission_customer_invoice_export/wizards/school_admission_create_invoice_export.py:0
#, python-format
msgid "- %s: not allowed to create invoice export (check state/policy)"
msgstr "- %s: tidak diizinkan membuat ekspor faktur (periksa status/kebijakan)"

