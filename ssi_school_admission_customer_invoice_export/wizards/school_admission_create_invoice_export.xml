<odoo>

<record id="school_admission_wizard_create_invoice_export_view_form" model="ir.ui.view">
    <field name="name">school_admission.wizard_create_invoice_export - form</field>
    <field name="model">school_admission.wizard_create_invoice_export</field>
    <field name="arch" type="xml">
        <form string="Create Invoice Export">
            <group name="main" colspan="4" col="2">
                <field name="admission_ids" invisible="1" />
                <field name="type_id" />
                <field name="date" />
                <field name="output_format" />
                <field name="date_start" />
                <field name="date_end" />
            </group>
            <footer>
                <button
                        name="action_create_invoice_export"
                        type="object"
                        string="Create Invoice Export"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record
        id="school_admission_wizard_create_invoice_export_action"
        model="ir.actions.act_window"
    >
    <field name="name">Create Invoice Export</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_admission.wizard_create_invoice_export</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="ssi_school_admission.model_school_admission" />
</record>

</odoo>
