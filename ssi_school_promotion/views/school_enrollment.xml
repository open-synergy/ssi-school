<odoo>

<record id="school_enrollment_view_form_promotion" model="ir.ui.view">
    <field name="name">school_enrollment form - promotion</field>
    <field name="model">school_enrollment</field>
    <field name="inherit_id" ref="ssi_school.school_enrollment_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath
                    expr="//field[@name='payment_term_ids']/tree/field[@name='state']"
                    position="after"
                >
                <field name="promotion_usage_count" string="Promotions" />
            </xpath>
            <xpath
                    expr="//field[@name='payment_term_ids']/tree/button[@name='action_open_duplicate_wizard']"
                    position="after"
                >
                <button
                        name="action_apply_promotion_code"
                        title="Apply Promotion Code"
                        type="object"
                        icon="fa-gift"
                        states="invoiced"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
