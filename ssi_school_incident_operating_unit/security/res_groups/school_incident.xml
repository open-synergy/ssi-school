<odoo>

<!-- Single "Operating Unit" group shared by every school_incident-family
     transactional model (school_incident, school_incident_weekly_review):
     the base ssi_school_incident module defines one shared handling-tier
     hierarchy (User/Officer/Manager) and one shared data ownership
     category for all of them, so there is no per-model "Company" group to
     hang this off of (unlike ssi_school_operating_unit, where each
     transactional model, school_enrollment and school_homeroom, has its
     own dedicated data ownership category and Company group). -->
<record id="school_incident_operating_unit_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="ssi_school_incident.school_incident_data_ownership_module_category"
        />
</record>

<!-- Manager (Principal) is the top handling tier: wire it into the new OU
     group so Managers are also evaluated against the OU-scoped ir.rule
     below, mirroring the "Company" group technique used by
     ssi_school_operating_unit. Uses (4, ...) to ADD to the existing
     implied_ids (already pointing at school_incident_officer_group from
     BL-0066) instead of (6, 0, ...), which would clobber that link. -->
<record id="ssi_school_incident.school_incident_manager_group" model="res.groups">
    <field
            name="implied_ids"
            eval="[(4, ref('school_incident_operating_unit_group'))]"
        />
</record>

</odoo>
